{
  "name": "clipmaster-ai",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "dev:api": "pnpm --filter @clipmaster/api dev",
