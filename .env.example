# ClipMaster AI — variables de entorno (cópialas en Dokploy → Environment).
# NUNCA subas valores reales al repositorio. Genera secretos con:  openssl rand -base64 48

# --- Dominio público (el mismo para web y API; Traefik enruta /api a la API)
PUBLIC_URL=https://clips.example.com
COOKIE_SECURE=true

# --- Secretos obligatorios (mínimo 32 caracteres)
SESSION_SECRET=
MEDIA_SIGNING_SECRET=
INTERNAL_API_TOKEN=

# --- PostgreSQL
POSTGRES_USER=clipmaster
POSTGRES_PASSWORD=
POSTGRES_DB=clipmaster

# --- Redis (BullMQ)
REDIS_PASSWORD=

# --- MinIO (almacenamiento S3 privado; no se expone a Internet)
MINIO_ROOT_USER=clipmaster
MINIO_ROOT_PASSWORD=
S3_BUCKET=clipmaster
S3_REGION=us-east-1
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- Cuentas
# Administrador inicial (se crea al arrancar si no existe). Contraseña de 12+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
DEFAULT_QUOTA_GB=50
# Recuperación de contraseña por correo (opcional; sin SMTP el endpoint responde 501)
SMTP_URL=
SMTP_FROM=ClipMaster AI <no-reply@example.com>

# --- Límites
MAX_UPLOAD_MB=4096
MAX_VIDEO_DURATION_SEC=14400
MAX_LIVE_DURATION_SEC=21600
MAX_ACTIVE_PROJECTS_PER_USER=3
RATE_LIMIT_PER_MINUTE=120
TEMP_RETENTION_HOURS=48
MEDIA_URL_TTL_SEC=3600
JOB_ATTEMPTS=3

# --- Directos
LIVE_SEGMENT_SECONDS=60
LIVE_CONTEXT_SECONDS=20
LIVE_QUALITY=720p,720p60,best
LIVE_MAX_RECONNECTS=6

# --- Captura / importación
CAPTURE_CONCURRENCY=2
IMPORT_MAX_HEIGHT=1080
MAX_DOWNLOAD_MB=8192

# --- IA (transcripción con faster-whisper)
# cpu | cuda | auto  (auto usa CUDA si funciona y cae a CPU si no)
AI_DEVICE=cpu
# tiny | base | small | medium | large-v3 | distil-large-v3 ...  (en CPU: small; con GPU 11 GB: medium o large-v3)
WHISPER_MODEL=small
# auto | int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=6
VISUAL_FPS=2

# --- LLM semántico opcional (desactivado por defecto; además cada usuario debe activarlo en Ajustes)
# ollama = local (perfil "llm" de compose) · nvidia = API de build.nvidia.com
LLM_PROVIDER=ollama
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b-instruct
# NVIDIA: sin clave no se envía nada. Con clave, los fragmentos de transcripción de los candidatos
# salen del servidor hacia NVIDIA. El nivel gratuito tiene créditos y límite de peticiones; revisa sus términos.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Render
# libx264 | h264_nvenc | auto   (auto: NVENC sólo si una codificación de prueba funciona)
RENDER_ENCODER=libx264
RENDER_PRESET=veryfast
RENDER_CRF=20
RENDER_CONCURRENCY=1
FFMPEG_THREADS=0

# --- GPU (sólo con compose.gpu.yaml). Índices de `nvidia-smi`.
AI_GPU_ID=0
RENDER_GPU_ID=0

# --- Logs
API_LOG_LEVEL=info
WORKER_LOG_LEVEL=INFO
