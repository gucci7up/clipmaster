generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  PENDING
  VALIDATING
  CAPTURING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

enum SourceKind {
  UPLOAD
  URL
}

enum Provider {
  UPLOAD
  YOUTUBE
  TWITCH
  KICK
  TIKTOK
  DIRECT
  HLS
}

enum ContentMode {
  AUTO
  GAMING
  DOMINO
  PODCAST
  INTERVIEW
  REACTION
  HUMOR
  EDUCATION
  SPORTS
  CUSTOM
}

enum AspectRatio {
  VERTICAL
  HORIZONTAL
  SQUARE
}

enum JobType {
  IMPORT
  LIVE_CAPTURE
  ANALYZE
  RENDER
  CLEANUP
  /// Título, descripción y hashtags de un clip con el LLM.
  COPY
  /// Miniatura con texto de un clip.
  THUMBNAIL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CaptureStatus {
  STARTING
  RECORDING
  RECONNECTING
  STOPPING
  ENDED
  FAILED
}

enum ClipStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

enum AssetKind {
  UPLOAD
  ORIGINAL
  SEGMENT
  AUDIO
  TRANSCRIPT
  SUBTITLE
  THUMBNAIL
  CLIP
  OTHER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(USER)
  storageQuotaBytes  BigInt    @default(53687091200) // 50 GiB
  storageUsedBytes   BigInt    @default(0)
  resetTokenHash     String?   @unique
  resetTokenExpires  DateTime?
  disabled           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions   Session[]
  projects   Project[]
  settings   UserSettings?
  aiSettings AISettings?
  assets     StorageAsset[]
  auditLogs  AuditLog[]
  captureAgents CaptureAgent[]
  subtitlePresets SubtitlePreset[]
  fonts         UserFont[]
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  name             String
  status           ProjectStatus @default(PENDING)
  mode             ContentMode   @default(AUTO)
  language         String?       // null = detección automática
  maxClips         Int           @default(10)
  minDuration      Int           @default(15)
  maxDuration      Int           @default(60)
  aspect           AspectRatio   @default(VERTICAL)
  subtitles        Boolean       @default(true)
  smartDetection   Boolean       @default(true)
  preference       String        @default("balanced")
  errorMessage     String?
  detectedLanguage String?
  processingMs     Int           @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      VideoSource?
  captures    CaptureSession[]
  assets      VideoAsset[]
  segments    VideoSegment[]
  jobs        ProcessingJob[]
  transcripts Transcript[]
  candidates  HighlightCandidate[]
  clips       Clip[]
  events      ProcessingEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model VideoSource {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @unique @db.Uuid
  kind       SourceKind
  provider   Provider
  url        String?
  isLive     Boolean    @default(false)
  title      String?
  uploadKey  String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CaptureSession {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  status        CaptureStatus @default(STARTING)
  segmentSeconds Int          @default(60)
  segmentsCount Int           @default(0)
  durationSec   Float         @default(0)
  reconnects    Int           @default(0)
  endedReason   String?
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments      VideoSegment[]

  @@index([projectId])
}

model VideoAsset {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  storageKey  String   @unique
  sizeBytes   BigInt
  durationSec Float
  width       Int?
  height      Int?
  fps         Float?
  hasAudio    Boolean
  hasVideo    Boolean
  videoCodec  String?
  audioCodec  String?
  container   String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VideoSegment {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @db.Uuid
  captureSessionId String?         @db.Uuid
  index            Int
  storageKey       String          @unique
  startSec         Float
  durationSec      Float
  sizeBytes        BigInt
  analyzed         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  captureSession   CaptureSession? @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)

  @@unique([captureSessionId, index])
  @@index([projectId, startSec])
}

model ProcessingJob {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  type        JobType
  status      JobStatus  @default(QUEUED)
  queue       String
  /// Clave de idempotencia lógica (p.ej. render:<clipId>:<renderId>).
  dedupeKey   String     @unique
  payload     Json
  result      Json?
  progress    Float?
  stage       String?
  attempts    Int        @default(0)
  error       String?
  errorHistory Json      @default("[]")
  queuedAt    DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@index([status, updatedAt])
}

model Transcript {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  segmentId   String?  @db.Uuid
  language    String?
  model       String?
  storageKey  String?
  srtKey      String?
  windowStart Float    @default(0)
  windowEnd   Float    @default(0)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]

  @@index([projectId])
}

model TranscriptSegment {
  id           String     @id @default(uuid()) @db.Uuid
  transcriptId String     @db.Uuid
  projectId    String     @db.Uuid
  start        Float
  end          Float
  text         String
  words        Json
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([projectId, start])
  @@index([transcriptId])
}

model HighlightCandidate {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  start     Float
  end       Float
  peakTime  Float
  score     Float
  title     String
  reason    String
  text      String
  signals   Json
  tags      String[]
  track     Json?
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip      Clip?

  @@index([projectId, score])
}

model Clip {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  candidateId   String?     @unique @db.Uuid
  title         String
  reason        String
  score         Float
  start         Float
  end           Float
  aspect        AspectRatio
  subtitles     Boolean     @default(true)
  subtitleStyle Json
  reframeMode   String      @default("auto")
  manualX       Float?
  manualY       Float?
  /// Palabras corregidas por el usuario: { start, end, words[] } sobre la línea de tiempo del proyecto.
  wordOverride  Json?
  hookEnabled   Boolean     @default(false)
  hookText      String?
  hookDuration  Float       @default(3)
  /// Clip combinado: tramos [{ start, end }] que se encadenan en orden.
  segments      Json?
  /// Funciones de IA de NVIDIA (sólo se aplican si el usuario activó AISettings.aiMedia).
  aiEyeContact  Boolean     @default(false)
  /// Preset de iluminación del servicio de NVIDIA (0-4) o null.
  aiRelight     Int?
  /// Voz Magpie para leer el título gancho, o null.
  hookVoice     String?
  /// Prompt de la portada generada con FLUX (NVIDIA), o null.
  coverPrompt   String?
  /// Texto para publicar generado con el LLM: { title, description, hashtags, model, generatedAt }.
  socialCopy    Json?
  /// PENDING | READY | FAILED, o null si nunca se pidió.
  socialStatus  String?
  socialError   String?
  /// Miniatura con texto: lo último que pidió el usuario ({ at, aspect, background, prompt, text, style }).
  thumbConfig   Json?
  thumbKey      String?
  /// PENDING | READY | FAILED, o null si nunca se pidió.
  thumbStatus   String?
  thumbError    String?
  status        ClipStatus  @default(PENDING)
  currentRenderId String?   @db.Uuid
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidate     HighlightCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  renders       ClipRender[]
  subtitleTracks SubtitleTrack[]

  @@index([projectId, score])
}

model ClipRender {
  id           String     @id @default(uuid()) @db.Uuid
  clipId       String     @db.Uuid
  status       ClipStatus @default(PENDING)
  start        Float
  end          Float
  aspect       AspectRatio
  outputKey    String?
  thumbnailKey String?
  coverKey     String?
  /// Estado de cada función de IA de NVIDIA en este render: { nombre: { status, error? } }.
  aiStatus     Json?
  sizeBytes    BigInt?
  durationSec  Float?
  width        Int?
  height       Int?
  encoder      String?
  error        String?
  renderMs     Int?
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  clip         Clip       @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt])
}

model SubtitleTrack {
  id         String   @id @default(uuid()) @db.Uuid
  clipId     String   @db.Uuid
  renderId   String?  @db.Uuid
  format     String   // ass | srt
  storageKey String
  createdAt  DateTime @default(now())
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId])
}

model ProcessingEvent {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  jobId     String?  @db.Uuid
  type      String
  stage     String?
  progress  Float?
  message   String?
  data      Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model UserSettings {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @db.Uuid
  defaultMode    ContentMode @default(AUTO)
  defaultAspect  AspectRatio @default(VERTICAL)
  defaultLanguage String?    @default("es")
  subtitleStyle  Json?
  hookTitles     Boolean     @default(true)
  theme          String      @default("system")
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AISettings {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  weights        Json?    // overrides por señal (modo CUSTOM y ajustes finos)
  visualAnalysis Boolean  @default(true)
  semanticLLM    Boolean  @default(false)
  /// Análisis con fotogramas (modelo de visión de NVIDIA): envía imágenes de los candidatos a NVIDIA.
  visionLLM      Boolean  @default(false)
  /// Efectos, voz y portadas de NVIDIA en el render: envía tramos de video, texto e indicaciones a NVIDIA.
  aiMedia        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StorageAsset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  projectId  String?   @db.Uuid
  kind       AssetKind
  key        String    @unique
  sizeBytes  BigInt
  mimeType   String?
  temporary  Boolean   @default(false)
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([projectId])
  @@index([temporary, expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  target    String?
  ip        String?
  data      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}

/// Capturador remoto (p. ej. el PC del usuario) que procesa importaciones de proveedores que
/// bloquean IPs de servidores. Se autentica con un token Bearer; sólo se guarda su hash.
model CaptureAgent {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

/// Estilo de subtítulos guardado con nombre para reutilizarlo.
model SubtitlePreset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  style     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fuente TTF/OTF subida por el usuario para los subtítulos.
model UserFont {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  family     String
  fileName   String
  storageKey String   @unique
  sizeBytes  Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
